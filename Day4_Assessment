package assessment;
import java.time.Duration;
import org.openqa.selenium.By;
import org.openqa.selenium.WebDriver;
import org.openqa.selenium.WebElement;
import org.openqa.selenium.chrome.ChromeDriver;

public class zomato {

	public static void main(String[] args) throws InterruptedException {
		WebDriver driver = new ChromeDriver();
		driver.manage().window().maximize();
		driver.manage().timeouts().implicitlyWait(Duration.ofSeconds(10));
		driver.get("https://www.zomato.com/bangalore/delivery");
		driver.findElement(By.xpath("//button[text()='Log in']")).click();
		Thread.sleep(1000);
		WebElement frame1 = driver.findElement(By.id("auth-login-ui"));
		driver.switchTo().frame(frame1);
		driver.findElement(By.xpath("//input[@type='number']")).sendKeys("6363627208");
		driver.switchTo().defaultContent();
		String text = driver.findElement(By.xpath("//div[text()='Delivery']")).getText();
		
		if(text.equals("Delivery"))
		{
			System.out.println("It is in main page");
		}
		}
	}

