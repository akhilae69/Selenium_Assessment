    @DataProvider
    public Object[][] JobDetails()
            throws EncryptedDocumentException, IOException {

        FileInputStream fis =
                new FileInputStream("./src/test/resources/DDt/OrangeHRM_Recruitment.xlsx");

        Workbook wb =
                WorkbookFactory.create(fis);

        Sheet sh =wb.getSheet("Sheet1");

        DataFormatter df =new DataFormatter();

        int count = 0;

        for (int i = 1;
             i <= sh.getLastRowNum();
             i++) {

            if (sh.getRow(i) != null &&
                sh.getRow(i).getCell(0) != null &&
                !df.formatCellValue(
                        sh.getRow(i).getCell(0))
                        .trim()
                        .isEmpty()) {

                count++;
            }
        }

        Object[][] data =
                new Object[count][4];

        int index = 0;

        for (int i = 1;
             i <= sh.getLastRowNum();
             i++) {

            if (sh.getRow(i) != null &&
                sh.getRow(i).getCell(0) != null &&
                !df.formatCellValue(
                        sh.getRow(i).getCell(0))
                        .trim()
                        .isEmpty()) {

                for (int j = 0; j < 4; j++) {

                    data[index][j] =df.formatCellValue(sh.getRow(i).getCell(j)).trim();
                }

                index++;
            }
        }

        wb.close();

        fis.close();

        return data;
    }

